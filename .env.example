# Host ports published by docker compose (the app listens on the same port inside)
APP_A_PORT=3001
APP_B_PORT=3002
REDIS_PORT=6379

# Set to true ONLY when the app runs behind a reverse proxy you control (e.g. nginx).
# Without a proxy, clients could spoof X-Forwarded-For and bypass the limiter.
TRUST_PROXY=false

# Only read when you run the app outside Docker, e.g.: node --env-file=.env dist/main
# (Nest does not load .env by itself)
PORT=3000
# Keep the port here in sync with REDIS_PORT above
REDIS_URL=redis://localhost:6379